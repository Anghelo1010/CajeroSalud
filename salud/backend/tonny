from machine import Pin, I2C
import time

# Configuración del I2C en ESP32
i2c = I2C(1, scl=Pin(19), sda=Pin(18), freq=100000)

# Direcciones I2C
ADDRESS_MAX30102 = 0x57
ADDRESS_MLX90614 = 0x5A

# ----------------- MAX30102 -----------------

def iniciar_sensor_max30102():
    try:
        i2c.writeto_mem(ADDRESS_MAX30102, 0x09, b'\x40')  # Reset
        time.sleep(0.1)
        i2c.writeto_mem(ADDRESS_MAX30102, 0x09, b'\x03')  # Modo SpO2
        i2c.writeto_mem(ADDRESS_MAX30102, 0x0A, b'\x27')  # Configuración SpO2
        i2c.writeto_mem(ADDRESS_MAX30102, 0x0C, b'\x1F')  # LED Rojo
        i2c.writeto_mem(ADDRESS_MAX30102, 0x0D, b'\x1F')  # LED IR
        i2c.writeto_mem(ADDRESS_MAX30102, 0x08, b'\x00')  # FIFO_WR_PTR
        i2c.writeto_mem(ADDRESS_MAX30102, 0x04, b'\x00')  # FIFO_RD_PTR
        i2c.writeto_mem(ADDRESS_MAX30102, 0x02, b'\x00')  # FIFO_OVF_COUNTER
        print("✅ Sensor MAX30102 configurado.")
        time.sleep(0.1)  # Espera a que se estabilice
    except Exception as e:
        print("❌ Error al iniciar MAX30102:", str(e))

def leer_sensor_max30102():
    try:
        # Opcional: leer el estado del puntero FIFO (registro 0x06)
        data = i2c.readfrom_mem(ADDRESS_MAX30102, 0x07, 6)
        if len(data) != 6:
            raise ValueError("Datos incompletos")
        red = ((data[0] << 16) | (data[1] << 8) | data[2]) & 0x3FFFF
        ir = ((data[3] << 16) | (data[4] << 8) | data[5]) & 0x3FFFF
        return red, ir
    except Exception as e:
        print("❌ Error al leer MAX30102:", str(e))
        return 0, 0

# ----------------- MLX90614 -----------------++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

def leer_temperatura_mlx90614(registro):
    try:
        data = i2c.readfrom_mem(ADDRESS_MLX90614, registro, 3)
        raw = data[0] | (data[1] << 8)
        temp_c = raw * 0.02 - 273.15
        return round(temp_c, 2)
    except Exception as e:
        print(f"❌ Error al leer MLX90614 reg {hex(registro)}:", str(e))
        return None

def leer_temperaturas():
    t_obj = leer_temperatura_mlx90614(0x07)  # Temperatura del objeto
    t_amb = leer_temperatura_mlx90614(0x06)  # Temperatura ambiente
    return t_obj, t_amb

# ----------------- Loop principal -----------------

iniciar_sensor_max30102()

while True:
    red, ir = leer_sensor_max30102()
    t_obj, t_amb = leer_temperaturas()

    print("🔴 RED:", red, "🌑 IR:", ir)
    print("🌡️ Temp Objeto:", t_obj, "°C | Temp Ambiente:", t_amb, "°C")
    print("-" * 40)
    time.sleep(1)



